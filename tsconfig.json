{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true, "noEmit": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "scripts", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "playwright.production.config.ts", "e2e"]
}
